{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Mirroring",
  "version": "0.1.1",
  "identifier": "com.screenmirroring.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Screen Mirroring",
        "width": 720,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/scrcpy-server": "resources/scrcpy-server",
      "resources/scrcpy-LICENSE.txt": "resources/scrcpy-LICENSE.txt",
      "resources/adb/*": "resources/adb/",
      "vendor/ffmpeg/bin/avcodec-62.dll": "avcodec-62.dll",
      "vendor/ffmpeg/bin/avutil-60.dll": "avutil-60.dll",
      "vendor/ffmpeg/bin/swresample-6.dll": "swresample-6.dll",
      "vendor/ffmpeg/LICENSE.txt": "resources/ffmpeg-LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
